# ============================================================
# Nabil Amin Hridoy — Portfolio CMS — Environment Variables
# Copy this file to .env and replace placeholders with real values.
# NEVER commit the real .env file (it is gitignored).
# ============================================================

# --- Database (PostgreSQL) ---
# Local dev:  postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public
# Production: use the platform-provided connection string (e.g. Neon/Supabase/Railway/Render).
#   sslmode=require is recommended for managed Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require

# --- NextAuth.js ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# --- Admin bootstrap (used by scripts/seed.ts only — change after first login) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMTP (used by contact form + password reset emails) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
